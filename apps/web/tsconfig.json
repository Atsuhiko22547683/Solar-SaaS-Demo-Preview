{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": ".next",
    "noEmit": true,
    "allowJs": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@solar/db": ["../../packages/db/src/index.ts"],
      "@solar/db/*": ["../../packages/db/src/*"],
      "@solar/contracts": ["../../packages/contracts/src/index.ts"],
      "@solar/contracts/*": ["../../packages/contracts/src/*"],
      "@solar/auth": ["../../packages/auth/src/index.ts"],
      "@solar/auth/*": ["../../packages/auth/src/*"],
      "@solar/storage": ["../../packages/storage/src/index.ts"],
      "@solar/storage/*": ["../../packages/storage/src/*"],
      "@solar/email": ["../../packages/email/src/index.ts"],
      "@solar/email/*": ["../../packages/email/src/*"],
      "@solar/ui": ["../../packages/ui/src/index.ts"],
      "@solar/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-partner-admin/types/**/*.ts",
    ".next-partner/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-system-admin/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".next-partner", ".next-partner-admin", ".next-system-admin"]
}
